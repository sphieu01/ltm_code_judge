# -- Database (Neon PostgreSQL) -----------------------------------
DB_URL=jdbc:postgresql://ep-dry-rice-b32otp6l-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=your_neon_password_here

# -- Server -------------------------------------------------------
SERVER_PORT=9999
CONNECTION_POOL_SIZE=20
JUDGE_WORKER_COUNT=4

# -- JWT Secret (chuoi bi mat >= 32 ky tu) ------------------------
JWT_SECRET=MyVerySecretKeyForCodeGradingSystem2024!ThisIsLong

