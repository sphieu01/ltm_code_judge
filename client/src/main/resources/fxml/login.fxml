<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.grading.client.controller.LoginController"
            styleClass="main-pane" prefWidth="900" prefHeight="600">

    <center>
        <VBox alignment="CENTER" spacing="0">
            <!-- Login Card -->
            <VBox styleClass="card" maxWidth="420" spacing="20" alignment="CENTER">
                <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

                <!-- Logo / Title -->
                <Label text="Auto Grader" styleClass="title-label"/>
                <Label text="Networked Code Grading System" styleClass="subtitle-label">
                    <VBox.margin><Insets bottom="10"/></VBox.margin>
                </Label>

                <Separator/>

                <!-- Server connection -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="hostField" promptText="Server host" text="localhost"
                               prefWidth="220"/>
                    <TextField fx:id="portField" promptText="Port" text="9999"
                               prefWidth="80"/>
                </HBox>

                <!-- Username -->
                <VBox spacing="4">
                    <Label text="Username" styleClass="label"/>
                    <TextField fx:id="usernameField" promptText="Enter username"/>
                </VBox>

                <!-- Password -->
                <VBox spacing="4">
                    <Label text="Password" styleClass="label"/>
                    <PasswordField fx:id="passwordField" promptText="Enter password"
                                   onAction="#handleLogin"/>
                </VBox>

                <!-- Full Name (for register) -->
                <VBox fx:id="fullNameBox" spacing="4" visible="false" managed="false">
                    <Label text="Full Name" styleClass="label"/>
                    <TextField fx:id="fullNameField" promptText="Enter full name"/>
                </VBox>

                <!-- Error message -->
                <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>

                <!-- Buttons -->
                <VBox spacing="10" alignment="CENTER">
                    <Button fx:id="loginBtn" text="Login" onAction="#handleLogin"
                            styleClass="btn-primary" maxWidth="Infinity"/>
                    <Button fx:id="registerBtn" text="Don't have an account? Register"
                            onAction="#toggleRegister" styleClass="btn-secondary" maxWidth="Infinity"/>
                </VBox>

                <!-- Loading indicator -->
                <ProgressIndicator fx:id="loadingIndicator" visible="false" prefWidth="30" prefHeight="30"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
